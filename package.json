{
  "name": "dsh-nudge",
  "version": "0.1.0",
  "private": true,
  "description": "DSH web plugin: a floating nudge that asks the agent for a short status report with one chosen prompt (presets in the window, delivery mode configurable) and lets the answer land in the conversation.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "node scripts/check-client.mjs && node scripts/check-host.mjs",
    "check:client": "node scripts/check-client.mjs",
    "check:host": "node scripts/check-host.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:all": "node scripts/preview.mjs --all"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
