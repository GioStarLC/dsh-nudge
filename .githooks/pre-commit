#!/bin/sh
# Guardrail: run the full gate before every commit (build freshness, types,
# unit checks, client/host checks, graph check).
# Installed by `npm run hooks:install` (see package.json) or:
#   git config core.hooksPath .githooks
# Skip once with: git commit --no-verify
#
# The gate is verbose (hundreds of assertions); a passing run keeps three lines,
# a failing one keeps the tail, so a commit stays readable either way.
set -e
echo "pre-commit: running checks (npm run check)…"
log=$(mktemp)
if ! npm run --silent check >"$log" 2>&1; then
  status=$?
  echo "pre-commit: checks failed; last 60 lines:" >&2
  tail -n 60 "$log" >&2
  rm -f "$log"
  exit $status
fi
tail -n 3 "$log"
rm -f "$log"

# `build --verify` reads the working tree; a commit records the index. An
# artifact rebuilt but not staged would commit the old bytes while the gate
# stays green, so refuse that case here.
for artifact in client.js client.settings-jump.js; do
  if ! git diff --quiet -- "$artifact"; then
    echo "pre-commit: $artifact has unstaged changes; stage the rebuilt artifact." >&2
    exit 1
  fi
done
echo "pre-commit: checks passed."
